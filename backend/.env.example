# --- Database (local Postgres; swap for Azure Database for PostgreSQL later) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mom_db

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

# --- File storage (local disk until Azure Blob is available) ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- Email: "console" writes .eml files to EMAIL_OUTBOX_DIR, "smtp" really sends ---
EMAIL_BACKEND=console
EMAIL_OUTBOX_DIR=./data/outbox
EMAIL_FROM=mom-bot@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

CORS_ORIGINS=["http://localhost:8501"]
