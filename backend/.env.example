# --- Core ---
PUBLIC_BASE_URL=http://localhost:8000
# Signs OAuth state + encrypts stored calendar tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Database (local Postgres; swap for Azure Database for PostgreSQL later) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mom_db

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Must support response_format=diarized_json (speaker labels + timestamps)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-4o-mini
TRANSCRIBE_CONCURRENCY=4
REFINE_BATCH_LINES=120

# --- Audio chunks from the overlay agent (local disk until Azure Blob) ---
AUDIO_DIR=./data/audio
MAX_CHUNK_MB=25
RETAIN_AUDIO=false

# --- Outlook calendar via Microsoft Graph (leave MS_CLIENT_ID empty to disable) ---
# App registration: Microsoft Entra admin center > App registrations > New registration
#   Redirect URI (Web): {PUBLIC_BASE_URL}/calendar/microsoft/callback
#   API permissions (delegated): Calendars.Read, User.Read, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Email: "console" writes .eml files to EMAIL_OUTBOX_DIR, "smtp" really sends ---
EMAIL_BACKEND=console
EMAIL_OUTBOX_DIR=./data/outbox
EMAIL_FROM=mom-bot@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

CORS_ORIGINS=["http://localhost:8501"]
