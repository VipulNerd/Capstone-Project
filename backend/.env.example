# --- Core ---
# The backend's own public URL (used for the Outlook OAuth redirect). On Azure: https://<app>.<env>.azurecontainerapps.io
PUBLIC_BASE_URL=http://localhost:8000
# Signs OAuth state + encrypts stored calendar tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Database (local Postgres; swap for Azure Database for PostgreSQL later) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mom_db

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible base URL. Azure OpenAI: https://<resource>.openai.azure.com/
OPENAI_BASE_URL=
# Azure OpenAI only: e.g. 2025-04-01-preview (uses the AzureOpenAI client; model names = deployment names)
OPENAI_API_VERSION=
# Must support response_format=diarized_json (speaker labels + timestamps)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-5.1
TRANSCRIBE_CONCURRENCY=4
REFINE_BATCH_LINES=120

# --- Audio chunks from the recorder ---
# local = files under AUDIO_DIR (dev). blob = Azure Blob Storage (required on Container Apps,
# whose disk is wiped on restart/scale-to-zero).
STORAGE_BACKEND=local
AUDIO_DIR=./data/audio
# Azure portal > storage account > Access keys > Connection string (only for STORAGE_BACKEND=blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=audio
MAX_CHUNK_MB=25
RETAIN_AUDIO=false
# Resume meetings left half-processed by a restart or scale-to-zero (run ONE replica)
RESUME_ON_STARTUP=true

# --- Outlook calendar via Microsoft Graph (leave MS_CLIENT_ID empty to disable) ---
# App registration: Microsoft Entra admin center > App registrations > New registration
#   Redirect URI (Web): {PUBLIC_BASE_URL}/calendar/microsoft/callback
#   API permissions (delegated): Calendars.Read, User.Read, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Email: "console" writes .eml files to EMAIL_OUTBOX_DIR, "smtp" really sends ---
EMAIL_BACKEND=console
EMAIL_OUTBOX_DIR=./data/outbox
EMAIL_FROM=mom-bot@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Browser origins allowed to call the API (JSON list). On Azure: the Static Web App URL,
# e.g. ["https://<name>.azurestaticapps.net"]. Local Vite dev server: http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
