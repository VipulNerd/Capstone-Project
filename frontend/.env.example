# Where the browser sends API calls.
# "/api" (default) is proxied to the backend by Vite in dev and by nginx in Docker,
# so no CORS setup is needed. Use a full URL to call the backend directly
# (then add this site's origin to the backend's CORS_ORIGINS).
# Azure Static Web Apps: build with VITE_API_BASE_URL=https://<backend>.azurecontainerapps.io
# (set at build time; it is baked into the JS bundle, so it is a URL, never a secret).
VITE_API_BASE_URL=/api

# Dev server only: where Vite forwards /api requests.
VITE_PROXY_TARGET=http://localhost:8000

# Length of each recorded audio slice. The backend recommends 2–5 minutes.
VITE_CHUNK_SECONDS=120

# Keep in sync with the backend's MAX_CHUNK_MB.
VITE_MAX_CHUNK_MB=25

# Semantic search screen (no backend endpoint yet).
VITE_FEATURE_SEARCH=false
