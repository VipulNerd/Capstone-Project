# Production settings for the Azure deployment. Copy to infra/azure.env (gitignored) and fill in.
# provision.ps1 reads this file; secrets end up as Container App secrets, never in git.
# Database, audio storage, SECRET_KEY, PUBLIC_BASE_URL and CORS are set up by the script itself.

# --- Azure OpenAI (Azure AI Foundry) ---
# Foundry portal > your resource > Keys and Endpoint
OPENAI_BASE_URL=https://<resource>.openai.azure.com/
# Azure API version: makes the backend call models by deployment. Required, because
# gpt-4o-transcribe-diarize isn't served on Azure's /openai/v1 API.
OPENAI_API_VERSION=2025-04-01-preview
OPENAI_API_KEY=
# Deployment names (Foundry > Deployments)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-5.1
TRANSCRIBE_CONCURRENCY=4

# --- Email (Gmail: Google account > Security > App passwords) ---
EMAIL_BACKEND=smtp
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Outlook calendar (Entra app registration; leave MS_CLIENT_ID empty to disable) ---
# Redirect URI (Web): https://<frontend-fqdn>/api/calendar/microsoft/callback
# provision.ps1 prints the exact URI once the frontend exists.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Audio ---
MAX_CHUNK_MB=25
RETAIN_AUDIO=false
