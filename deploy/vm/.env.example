# Copy to deploy/vm/.env ON THE VM (deploy.sh keeps it at /opt/mom/.env). Never commit the real file.
# File permissions on the VM: chmod 600, owned by the deploy user.

# --- Site ---
# The VM's DNS name: <label>.southindia.cloudapp.azure.com
SITE_DOMAIN=mom-example.southindia.cloudapp.azure.com

# --- Secrets generated once (letters and digits only; used inside a URL) ---
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Azure OpenAI (Foundry resource audio-transcription-ai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://<foundry-resource>.openai.azure.com/
OPENAI_API_VERSION=2025-04-01-preview
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-5.1
TRANSCRIBE_CONCURRENCY=4

# --- Audio ---
MAX_CHUNK_MB=25
RETAIN_AUDIO=false

# --- Email: console = saved on the server only (NOTHING is emailed), smtp = send ---
# Gmail: SMTP_USERNAME = the Gmail address, SMTP_PASSWORD = a 16-character app password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification). EMAIL_FROM empty = SMTP_USERNAME.
# Easiest: run deploy/vm/set-email.ps1, which sets these on the VM and tests the login.
# Port 465 (implicit TLS) also works.
EMAIL_BACKEND=console
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Google Calendar (optional; leave empty to disable). See deploy/vm/README.md ---
# Redirect URI to register: <PUBLIC_BASE_URL>/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook calendar (optional; leave empty to disable) ---
# Redirect URI: https://<SITE_DOMAIN>/api/calendar/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
